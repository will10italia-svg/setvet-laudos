    const orgaosCompativeis = Object.entries(CONFIGURACAO_ORGAOS).filter(([chave, orgao]) => {
      const idOrgao = orgao.id || chave;
      return !orgaoEhIncompativelComSexo(idOrgao, sexoAtual);
