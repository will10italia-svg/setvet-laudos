    txt += `<div class="${classeRef}"><span>Ref Ovários: (Cão: 2,0cm)</span></div>`;
    txt += `Contornos ${c.contornos}, ecogenicidade ${c.ecogenicidade} e ecotextura ${c.ecotextura}.`;

    if (this.chipsSelecionados.includes('CistoFoliculo')) {
