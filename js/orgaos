    const valDirCaudal = parseFloat(valDirCaudalStr) || 0;
    const maxLimit = 0.58; // Referência cão até 10kg

    if (valEsqCaudalStr !== '0,00' && valEsqCaudalStr !== '0') {
      this.campos.aeDimensao = valEsqCaudal > maxLimit ? 'aumentadas' : 'normais';
