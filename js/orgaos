      txt += `<br><br>Observa-se ${termoEst} arredondada, de contornos definidos e pouco irregulares, paredes finas, ${termoEco}, localizada em ${c.cistoLocal} e medindo ${medidas} (Pode estar relacionado a cisto ou folículo).`;
